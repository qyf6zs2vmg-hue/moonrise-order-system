{
  "entities": {
    "invite": {
      "title": "Invite Code",
      "description": "An invite code for users to sign up",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "used": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["code", "used", "createdAt"]
    },
    "user": {
      "title": "User",
      "description": "A registered user or request",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "inviteCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "blocked", "admin"] },
        "createdAt": { "type": "number" },
        "uid": { "type": "string" }
      },
      "required": ["name", "phone", "inviteCode", "status", "createdAt", "uid"]
    },
    "order": {
      "title": "Order",
      "description": "A user's order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerInvite": { "type": "string" },
        "itemsJson": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "number" }
      },
      "required": ["customerName", "customerPhone", "customerInvite", "itemsJson", "total", "status", "createdAt"]
    },
    "admin": {
      "title": "Admin",
      "description": "Admin privileges",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["role"]
    }
  },
  "firestore": {
    "/invites/{codeId}": {
      "schema": { "$ref": "#/entities/invite" },
      "description": "Stores generated invite codes"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Stores user profiles and pending requests"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/order" },
      "description": "Stores user orders"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admin" },
      "description": "Stores admin roles"
    }
  }
}
